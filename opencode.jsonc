{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-clean-code-plugin",
    "funnel-architect-plugin-opencode"
  ],
  "agent": {
    "ask": {
      "description": "Local recon scout. Explore local filesystem only. Read, Grep, Glob, WebFetch. Never writes code or runs bash — engine-level enforced.",
      "prompt": "{file:./agents/ask.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "ssh-recon": {
      "description": "Remote recon scout. SSH into servers. Read-only inspection commands only. No writes, no mutations — prompt-level constrained.",
      "prompt": "{file:./agents/ssh-recon.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    }
  }
}