{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-clean-code-plugin",
    "funnel-architect-plugin-opencode"
  ],
  "agent": {
    "ask": {
      "description": "Recon scout. Explores codebase with read-only bash, gathers intelligence, reports findings, and recommends approaches. Never writes code — engine-level enforced.",
      "prompt": "{file:./agents/ask.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    }
  }
}